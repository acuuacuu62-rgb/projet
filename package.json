{
  "name": "zetainstall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 0.0.0.0",
    "dev:api": "tsx backend/main.ts",
    "dev:worker": "tsx worker/main.ts",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "api": "tsx backend/main.ts",
    "worker": "tsx worker/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:runner": "python3 -m py_compile runner/agent.py",
    "test:runner": "python3 -m unittest discover -s tests/runner -v",
    "admin": "tsx scripts/admin.ts",
    "format": "prettier --write app components lib backend worker scripts tests next.config.ts tsconfig.json package.json postcss.config.mjs",
    "test:email": "tsx --test tests/integration/email.test.ts",
    "test:e2e": "node tests/e2e/browser.mjs",
    "test:e2e:profiles": "node tests/e2e/profiles.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@tailwindcss/postcss": "^4.3.5",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "ipaddr.js": "^2.2.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ssh2": "1.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "yaml": "^2.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ssh2": "^1.15.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
