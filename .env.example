# Generate secret key files automatically in development. Use an external private directory in production.
DATA_DIR=.data
KEY_DIR=.data/keys
APP_ORIGIN=http://localhost:3000
# Comma separated exact origins. Add the registered Preview origin for browser authentication.
ALLOWED_ORIGINS=http://localhost:3000
API_HOST=127.0.0.1
API_PORT=4000
INTERNAL_PORT=4001
NODE_ENV=development
# Production browser uses direct HTTPS API; keep dev rewrites only for local Preview.
# NEXT_PUBLIC_API_URL=https://api.example.com/v1
# SMTP_URL=smtps://user:password@smtp.example.com:465
# MAIL_FROM=ZetaInstall <noreply@example.com>
# ADMIN_EMAIL=owner@example.com
# ENABLE_INSTALLERS=false
# Optional alternative to SMTP:
# RESEND_API_KEY=your-provider-key
# RESEND_BASE_URL=https://api.resend.com
# MAIL_FROM must be a verified sender for real email delivery.
